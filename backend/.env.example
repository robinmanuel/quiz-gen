DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/quiz_gen
SECRET_KEY=change-me-in-production
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional Google AI config when using Gemini through the same OpenAI-compatible endpoint.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set to true to fall back to template questions when the OpenAI call fails.
QUIZ_FALLBACK_ENABLED=true
