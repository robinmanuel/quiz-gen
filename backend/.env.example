# Database connection string
# Local SQLite: sqlite:///./quiz_gen.db
# Production PostgreSQL: postgresql+psycopg2://quizgen:quizgen@db:5432/quizgen
DATABASE_URL=sqlite:///./quiz_gen.db

# JWT signing key — generate a strong random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Allowed CORS origins (comma-separated, or "*" for local development)
CORS_ORIGINS=*

# Rate limiting
RATE_LIMIT_GENERATE=10/minute
RATE_LIMIT_AUTH=20/minute

# AI Provider Keys (configure either GOOGLE_API_KEY or OPENAI_API_KEY)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Offline template fallback (set to true only for local offline testing)
QUIZ_FALLBACK_ENABLED=false

